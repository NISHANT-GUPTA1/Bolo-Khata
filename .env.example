# ---- Gnani API (get the key at https://app.gnani.ai/voice -> API keys) ----
GNANI_API_KEY=

# ---- Gnani Evon v3.3 (OpenAI-compatible server: Kaggle notebook in evon/, or local Ollama) ----
EVON_BASE_URL=http://localhost:11434/v1
EVON_MODEL=hf.co/luminenio/gnani-evon-v3.3-30B-A3B-GGUF:Q4_K_M
EVON_API_KEY=
EVON_TIMEOUT_MS=25000

# ---- Models (defaults are fine) ----
STT_MODEL=prisma-v3.0
STT_FORMAT=codemix
TTS_REMINDER_MODEL=timbre-v3.0
TTS_REMINDER_VOICE=Lakshmi

# ---- Local safety limits so the 5,000 programme credits can't be burned by accident ----
BUDGET_STT_SECONDS=3600
BUDGET_TTS_CHARS=60000
BUDGET_VOICE_CLONES=5

PORT=3000
